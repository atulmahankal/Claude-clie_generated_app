# JAM Stack Application Environment Configuration

# ===== APPLICATION HOSTNAME =====
# Custom hostname for accessing the application (like DDEV)
# Default: jamstack.local
# After changing this, run: sudo ./script.sh setup-hostname
APP_HOSTNAME=jamstack.local

# Mailpit hostname (optional subdomain)
# Default: mailpit.jamstack.local
# Leave empty to use localhost:8030
MAILPIT_HOSTNAME=mailpit.jamstack.local

# ===== NODE ENVIRONMENT =====
NODE_ENV=production

# ===== NGINX =====
NGINX_PORT=80

# ===== BASE APPLICATION =====
BASE_DB_PASSWORD=postgres
BASE_DB_PORT=5436
BASE_HTTP_PORT=3000

# ===== AUTH SERVICE =====
AUTH_DB_PASSWORD=postgres
AUTH_DB_PORT=5433
AUTH_HTTP_PORT=3001
AUTH_GRPC_PORT=50051
JWT_SECRET=change-this-in-production-to-a-secure-random-string
JWT_REFRESH_SECRET=change-this-in-production-to-another-secure-random-string

# ===== TODOS SERVICE =====
TODOS_DB_PASSWORD=postgres
TODOS_DB_PORT=5435
TODOS_HTTP_PORT=3002
TODOS_GRPC_PORT=50052

# ===== FUNDFLOW SERVICE =====
FUNDFLOW_DB_PASSWORD=postgres
FUNDFLOW_DB_PORT=5434
FUNDFLOW_HTTP_PORT=3003
FUNDFLOW_GRPC_PORT=50053

# ===== MAILPIT (Email Testing) =====
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_UI_PORT=8030
MAILPIT_SMTP_PORT=1030
