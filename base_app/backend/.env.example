# Application
APP_NAME=JAM Stack Base Application
APP_VERSION=1.0.0
DEBUG=false

# Server
HTTP_PORT=3000

# Database
DB_HOST=base-app-db
DB_PORT=5432
DB_NAME=base_app
DB_USER=postgres
DB_PASSWORD=postgres

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:80

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
