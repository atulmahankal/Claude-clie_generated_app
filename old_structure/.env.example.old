# Environment Configuration for JAM Stack Application
# Copy this file to .env and adjust values as needed

# ===== DEPLOYMENT MODE =====
NODE_ENV=production  # Use 'development' for dev mode

# ===== DATABASE CONFIGURATION =====
# Auth Database
AUTH_DB_PASSWORD=postgres
AUTH_DB_PORT=5433

# Shared Database (Todos)
SHARED_DB_PASSWORD=postgres
SHARED_DB_PORT=5435

# Fundflow Database
FUNDFLOW_DB_PASSWORD=postgres
FUNDFLOW_DB_PORT=5434

# ===== SERVICE PORTS =====
# Auth Service
AUTH_HTTP_PORT=3011
AUTH_GRPC_PORT=50051

# Todos Service
TODOS_HTTP_PORT=3002
TODOS_GRPC_PORT=50052

# Fundflow Service
FUNDFLOW_HTTP_PORT=3003
FUNDFLOW_GRPC_PORT=50053

# Frontend
FRONTEND_PORT=3010

# ===== DEVELOPMENT TOOLS =====
# Mailpit (Email Testing)
MAILPIT_UI_PORT=8030
MAILPIT_SMTP_PORT=1030

# Adminer (Database UI)
ADMINER_PORT=8080

# ===== EMAIL CONFIGURATION =====
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@jamstack.app
SMTP_FROM_NAME=JAM Stack App

# ===== PASSWORD RESET CONFIGURATION =====
PASSWORD_RESET_CODE_EXPIRY_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15

# ===== EMAIL VERIFICATION CONFIGURATION =====
EMAIL_VERIFICATION_CODE_EXPIRY_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# ===== FRONTEND URL =====
# Used for generating password reset links in emails
FRONTEND_URL=http://localhost:3010
