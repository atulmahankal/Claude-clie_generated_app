{
  "name": "jam-stack-monorepo",
  "version": "2.0.0",
  "description": "Modular JAM Stack application with micro-frontend architecture",
  "private": true,
  "workspaces": [
    "base_app/frontend",
    "base_app/shared-ui",
    "services/*/frontend"
  ],
  "scripts": {
    "dev": "docker compose --profile dev up",
    "dev:build": "docker compose --profile dev up --build",
    "prod": "docker compose --profile prod up -d",
    "prod:build": "docker compose --profile prod up -d --build",
    "stop": "docker compose down",
    "clean": "docker compose down -v",
    "logs": "docker compose logs -f",
    "restart": "docker compose restart",
    "service:base": "docker compose --profile base up",
    "service:auth": "docker compose --profile auth up",
    "service:todos": "docker compose --profile todos up",
    "service:fundflow": "docker compose --profile fundflow up",
    "build:ui": "npm run build --workspace=@jam/shared-ui",
    "build:frontends": "npm run build --workspaces --if-present"
  },
  "keywords": [
    "jamstack",
    "micro-frontend",
    "nextjs",
    "fastapi",
    "python",
    "typescript",
    "docker",
    "microservices"
  ],
  "author": "",
  "license": "MIT"
}
