{
  "name": "@jam/grpc-protos",
  "version": "1.0.0",
  "description": "gRPC Protocol Buffer definitions for all microservices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "proto:generate": "npm run proto:auth && npm run proto:todos && npm run proto:fundflow",
    "proto:auth": "grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./dist --grpc_out=grpc_js:./dist --plugin=protoc-gen-grpc=`which grpc_tools_node_protoc_plugin` -I ./src ./src/auth.proto",
    "proto:todos": "grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./dist --grpc_out=grpc_js:./dist --plugin=protoc-gen-grpc=`which grpc_tools_node_protoc_plugin` -I ./src ./src/todos.proto",
    "proto:fundflow": "grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./dist --grpc_out=grpc_js:./dist --plugin=protoc-gen-grpc=`which grpc_tools_node_protoc_plugin` -I ./src ./src/fundflow.proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.14",
    "@grpc/proto-loader": "^0.7.10"
  },
  "devDependencies": {
    "@types/node": "^20"
  }
}
