{
  "name": "jam-stack-microservices",
  "version": "1.0.0",
  "description": "JAM Stack Application with Microservices Architecture",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "dev": "docker compose --profile dev up",
    "dev:build": "docker compose --profile dev up --build",
    "dev:down": "docker compose --profile dev down",
    "prod": "docker compose --profile prod up -d",
    "prod:build": "docker compose --profile prod up --build -d",
    "prod:down": "docker compose --profile prod down",
    "start": "docker compose --profile dev up -d",
    "stop": "docker compose down",
    "restart": "docker compose restart",
    "logs": "docker compose logs -f",
    "logs:auth": "docker compose logs -f auth-service",
    "logs:todos": "docker compose logs -f todos-service",
    "logs:fundflow": "docker compose logs -f fundflow-service",
    "logs:frontend": "docker compose logs -f frontend",
    "logs:kong": "docker compose logs -f kong",
    "service:auth": "docker compose --profile auth up",
    "service:todos": "docker compose --profile todos up",
    "service:fundflow": "docker compose --profile fundflow up",
    "service:frontend": "docker compose --profile frontend up",
    "service:gateway": "docker compose --profile gateway up",
    "proto:generate": "npm run proto:generate --workspace=packages/grpc-protos",
    "build:all": "npm run build --workspaces",
    "test:all": "npm run test --workspaces",
    "install:all": "npm install",
    "clean": "docker compose down -v",
    "clean:all": "docker system prune -af --volumes"
  },
  "keywords": [
    "microservices",
    "grpc",
    "nextjs",
    "typescript",
    "postgres",
    "mysql",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
