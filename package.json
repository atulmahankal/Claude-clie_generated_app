{
  "name": "jam-stack-microservices",
  "version": "1.0.0",
  "description": "JAM Stack Application with Microservices Architecture",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "dev": "docker compose -f docker/docker-compose.local.yml up",
    "dev:build": "docker compose -f docker/docker-compose.local.yml up --build",
    "dev:down": "docker compose -f docker/docker-compose.local.yml down",
    "dev:auth": "docker compose -f services/auth-service/docker-compose.yml up",
    "dev:todos": "docker compose -f services/todos-service/docker-compose.yml up",
    "dev:fundflow": "docker compose -f services/fundflow-service/docker-compose.yml up",
    "proto:generate": "npm run proto:generate --workspace=packages/grpc-protos",
    "build:all": "npm run build --workspaces",
    "test:all": "npm run test --workspaces",
    "install:all": "npm install"
  },
  "keywords": [
    "microservices",
    "grpc",
    "nextjs",
    "typescript",
    "postgres",
    "mysql",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
