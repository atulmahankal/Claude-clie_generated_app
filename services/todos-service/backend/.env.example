# Application
APP_NAME=Auth Service
APP_VERSION=1.0.0
DEBUG=false
SERVICE_VERSION=1.0.0

# Server
HTTP_PORT=3001
GRPC_PORT=50051

# Database
DB_HOST=auth-db
DB_PORT=5432
DB_NAME=auth
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@jamstack.local
SMTP_FROM_NAME=JAM Stack Auth
SMTP_USE_TLS=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:80

# Rate Limiting
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_WINDOW_MINUTES=15
EMAIL_VERIFY_MAX_ATTEMPTS=5
EMAIL_VERIFY_WINDOW_MINUTES=15
